# ──────────────────────────────────────────────
# FocusFlow Backend — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to ".env" and fill in your values.
#   cp .env.example .env

# MongoDB connection string
# For local MongoDB:  mongodb://localhost:27017/focusflow
# For MongoDB Atlas:  mongodb+srv://<user>:<pass>@cluster.xxxxx.mongodb.net/focusflow
MONGO_URI=mongodb://localhost:27017/focusflow

# Secret key used to sign JWT tokens (pick any random string)
JWT_SECRET=my_super_secret_key_change_me

# Port the server will run on
PORT=5000
